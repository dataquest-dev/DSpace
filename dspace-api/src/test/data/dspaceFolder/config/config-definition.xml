<?xml version="1.0"?>
<!--
     DSpace Configuration Definition - INTEGRATION TEST OVERRIDE

     This is a TEST-ONLY copy of dspace/config/config-definition.xml. It is identical to the production
     definition EXCEPT that automatic configuration reloading is turned OFF (config-reload="false").

     Why: the production definition marks local.cfg / clarin-dspace.cfg / dspace.cfg as
     config-reload="true" with a 5s refresh delay. During tests, individual tests change configuration at
     runtime via ConfigurationService.setProperty(...). Those runtime overrides live in the in-memory view
     of the combined configuration and are DISCARDED whenever the combined configuration is rebuilt. The
     auto-reload listener rebuilds it as soon as one of the reloadable cfg files' last-modified timestamp
     changes (which happens intermittently during a CI run). When that rebuild lands between a test's
     setProperty(...) and the code that reads it back, the runtime override is silently lost and the
     on-disk default is restored.

     A concrete symptom was the flaky AuthenticationRestControllerIT: tests set the auth plugin sequence to
     a single method (e.g. Shibboleth-only) but the WWW-Authenticate header intermittently also contained
     "password realm", because a mid-test reload restored clarin-dspace.cfg's default
     [PasswordAuthentication, ClarinShibAuthentication].

     Turning auto-reload off makes runtime setProperty overrides deterministic within a test. The explicit
     per-test reset in AbstractIntegrationTestWithDatabase#destroy() (ConfigurationService.reloadConfig())
     still works, because that calls invalidate() directly rather than relying on the auto-reload listener.
-->
<configuration>
    <header>
        <providers>
            <provider
                    config-tag="dspaceenv"
                    config-class="org.dspace.servicemanager.config.DSpaceEnvironmentConfigurationBuilderProvider" />
        </providers>
    </header>
    <!-- Configurations in this section override one another.
         Earlier values take precedence, and override any values in later config files -->
    <override>
        <!-- Load Java System properties (does not automatically reload) -->
        <system/>
        <!-- Load Environment variables (does not automatically reload) -->
        <env/>
        <!-- Environment variables with encoded special characters (see production config-definition.xml) -->
        <dspaceenv/>

        <!-- Allow user to override any configs in a local.cfg. Auto-reload disabled for tests (see header). -->
        <properties fileName="local.cfg" throwExceptionOnMissing="false" config-name="local" config-optional="true"
                    encoding="UTF-8" config-reload="false"/>

        <!-- Separate our changes from original dspace source. Auto-reload disabled for tests (see header). -->
        <properties fileName="clarin-dspace.cfg" throwExceptionOnMissing="true" config-name="clarin"
                    encoding="UTF-8" config-reload="false"/>

        <!-- Load our dspace.cfg (which in turn loads all module configs via "include=" statements). -->
        <properties fileName="dspace.cfg" throwExceptionOnMissing="true" encoding="UTF-8" config-reload="false"/>
    </override>

</configuration>
